<Window x:Class="VideoWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoWallpaper"
        mc:Ignorable="d"
        Title="Video Wallpaper" Height="360" Width="480"
        ResizeMode="CanMinimize"
        Icon="icon.ico"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Video Wallpaper" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Pick a video and set it as your animated desktop background." FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="VideoPathBox" Grid.Column="0" IsReadOnly="True" Padding="8" VerticalContentAlignment="Center"
                     Background="#2A2A2A" Foreground="White" BorderBrush="#444444" Text="No video selected"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox x:Name="MuteCheckBox" Content="Mute audio" Foreground="White" VerticalAlignment="Center" Checked="MuteCheckBox_Changed" Unchecked="MuteCheckBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="ApplyButton" Content="Set as Wallpaper" Click="ApplyButton_Click" Background="#0A7A3E"/>
            <Button x:Name="StopButton" Content="Stop Wallpaper" Margin="10,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,16,0,0" Foreground="#7FBF7F" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
    </Grid>
</Window>
